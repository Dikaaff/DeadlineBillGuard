# Copy to .env.local for local development.
# Never commit real secrets.

# --- Core ---
# Required in production: generate with `openssl rand -base64 32`.
# Local fallback exists in src/lib/session.ts but must be overridden in production.
AUTH_SECRET=change-me-openssl-rand-base64-32

# Public origin of the app (used for absolute URLs in emails, PayPal return/webhook).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Framework mode. Set to production when deploying.
NODE_ENV=development

# Vercel injects this automatically when deployed.
# VERCEL_URL=

# Optional shared secret for GET/POST /api/cron/reminders.
# Requests may pass ?secret=... or Authorization: Bearer ...
# Leave empty to allow open local invocation.
# CRON_SECRET=

# Optional override for the file-backed JSON store directory (defaults to ./.data).
# DBG_DATA_DIR=.data

# --- AI extraction (Groq primary, Gemini fallback) ---
# Both are optional. With no key the deterministic heuristic parser is used.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Email delivery (Resend) ---
# Without a key, reminder emails are logged and suppressed for @billguard.app test addresses.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
REMINDER_FROM=Bill Guard <reminders@billguard.app>

# --- PayPal ---
# Get client id/secret from https://developer.paypal.com/
# PAYPAL_MODE=live  (anything else = sandbox)
# Without credentials the app runs in demo mode (SIM-/CAP- mock order ids).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_MERCHANT_EMAIL=you@billguard.app
# From the webhook configuration page in the PayPal developer dashboard.
PAYPAL_WEBHOOK_ID=
